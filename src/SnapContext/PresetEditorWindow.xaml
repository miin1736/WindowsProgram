<Window x:Class="SnapContext.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapContext - 프리셋 편집"
        Width="680"
        Height="500"
        MinWidth="600"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic"
        FontSize="13"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   Margin="0,0,0,12"
                   Text="프리셋은 이름과 설명문 한 쌍입니다. 캡처할 때 고른 프리셋의 설명문이 이미지 아래에 들어가서, 이미지 한 장만 붙여넣어도 AI가 무엇을 해야 하는지 알 수 있습니다. 목록의 위에서부터 1, 2, 3… 번이며 최대 9개까지 만들 수 있습니다." />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="AddButton" Content="추가" Padding="10,3" Margin="0,0,6,6" Click="AddButton_Click" />
                    <Button x:Name="DeleteButton" Content="삭제" Padding="10,3" Margin="0,0,6,6" Click="DeleteButton_Click" />
                    <Button x:Name="UpButton" Content="▲" Padding="10,3" Margin="0,0,6,6" ToolTip="위로" Click="UpButton_Click" />
                    <Button x:Name="DownButton" Content="▼" Padding="10,3" Margin="0,0,6,6" ToolTip="아래로" Click="DownButton_Click" />
                </WrapPanel>
                <ListBox x:Name="PresetList" SelectionChanged="PresetList_SelectionChanged" />
            </DockPanel>

            <StackPanel Grid.Column="2" x:Name="EditPanel">
                <TextBlock Text="이름" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" MaxLength="20" Padding="6,4" TextChanged="NameBox_TextChanged" />

                <TextBlock Text="이미지에 붙는 설명" Margin="0,12,0,4" />
                <TextBox x:Name="CaptionBox"
                         MaxLength="300"
                         Height="130"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="6,4"
                         TextChanged="CaptionBox_TextChanged" />
                <TextBlock x:Name="CounterText" HorizontalAlignment="Right" Foreground="#777" FontSize="11" Margin="0,2,0,0" />

                <TextBlock Text="캡처할 때 기본으로 쓸 프리셋" Margin="0,12,0,4" />
                <ComboBox x:Name="DefaultBox" Padding="6,4" SelectionChanged="DefaultBox_SelectionChanged" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       x:Name="EmptyText"
                       Visibility="Collapsed"
                       Foreground="#777"
                       TextWrapping="Wrap"
                       Text="프리셋이 없습니다. 왼쪽의 추가 버튼을 눌러 만들어 보세요. 프리셋이 없으면 캡처에는 설명이 붙지 않습니다." />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="18" />

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="기본 프리셋으로 되돌리기" Padding="10,4" Click="ResetButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="저장" Padding="18,4" Margin="0,0,8,0" Click="SaveButton_Click" />
                <Button x:Name="CloseButton" Content="닫기" Padding="18,4" Click="CloseButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
